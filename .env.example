# Local development only. Production uses Supabase PostgreSQL; see docs/postgresql.md.
DATABASE_URL="file:./dev.db"
# Production: set DATABASE_URL to Supabase Session pooler and POSTGRES_DATABASE_URL
# to a migration-capable connection for the same Supabase project.
# POSTGRES_DATABASE_URL="postgresql://..."
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="https://erp.example.com"
BOOTSTRAP_ADMIN_NAME="System Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-unique-password"
DEMO_USER_PASSWORD="replace-with-a-separate-strong-demo-password"
