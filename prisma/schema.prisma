generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SystemMetadata {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id     String           @id @default(cuid())
  key    String           @unique
  name   String
  module String
  roles  RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String
  details   String?
  createdAt DateTime @default(now())
}

model Company {
  id                  String               @id @default(cuid())
  name                String               @unique
  type                String
  taxNumber           String?
  phone               String?
  active              Boolean              @default(true)
  sectors             Sector[]
  projects            Project[]
  subcontractAccounts SubcontractAccount[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Sector {
  id        String    @id @default(cuid())
  name      String
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  active    Boolean   @default(true)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([name, companyId])
}

model Project {
  id                  String                      @id @default(cuid())
  code                String                      @unique
  name                String
  companyId           String
  company             Company                     @relation(fields: [companyId], references: [id])
  sectorId            String?
  sector              Sector?                     @relation(fields: [sectorId], references: [id])
  status              String                      @default("ACTIVE")
  active              Boolean                     @default(true)
  supervisors         ProjectEngineerAssignment[]
  incomingContracts   IncomingContract[]
  subcontractAccounts SubcontractAccount[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
}

model IncomingContract {
  id                String              @id @default(cuid())
  number            String              @unique
  name              String
  projectId         String
  project           Project             @relation(fields: [projectId], references: [id])
  originalCents     Float
  estimateReference String?
  notes             String?
  statements        IncomingStatement[]
  memos             IncomingMemo[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

model IncomingStatement {
  id               String                @id @default(cuid())
  contractId       String
  contract         IncomingContract      @relation(fields: [contractId], references: [id])
  sequence         Int
  kind             String                @default("CURRENT")
  grossCents       Float
  stage            String                @default("COMPANY")
  submittedAt      DateTime              @default(now())
  paidAt           DateTime?
  paymentMethod    String?
  paymentReference String?
  notes            String?
  materials        MaterialCertificate[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([contractId, sequence])
}

model MaterialCertificate {
  id          String                    @id @default(cuid())
  number      String                    @unique
  statementId String
  statement   IncomingStatement         @relation(fields: [statementId], references: [id])
  totalCents  Float
  notes       String?
  items       MaterialCertificateItem[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
}

model MaterialCertificateItem {
  id             String              @id @default(cuid())
  certificateId  String
  certificate    MaterialCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  name           String
  unit           String
  quantity       Float
  unitPriceCents Float
  totalCents     Float
}

model IncomingMemo {
  id          String           @id @default(cuid())
  contractId  String
  contract    IncomingContract @relation(fields: [contractId], references: [id])
  kind        String
  amountCents Float
  reason      String
  createdAt   DateTime         @default(now())
}

model IncomingAttachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  name       String
  mime       String
  size       Int
  data       Bytes
  actorId    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model Employee {
  id           String                      @id @default(cuid())
  employeeCode String                      @unique
  name         String
  jobTitle     String
  phone        String?
  active       Boolean                     @default(true)
  supervisors  ProjectEngineerAssignment[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt
}

model ProjectEngineerAssignment {
  id         String    @id @default(cuid())
  projectId  String
  employeeId String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@unique([projectId, employeeId, startDate])
}

model SubcontractAccount {
  id          String                 @id @default(cuid())
  name        String
  companyId   String
  company     Company                @relation(fields: [companyId], references: [id])
  projectId   String
  project     Project                @relation(fields: [projectId], references: [id])
  scope       String
  notes       String?
  statements  SubcontractStatement[]
  withdrawals WorkWithdrawal[]       @relation("WithdrawalSource")
  assignments WorkWithdrawal[]       @relation("WithdrawalDestination")
  createdAt   DateTime               @default(now())
}

model SubcontractStatement {
  id                  String                 @id @default(cuid())
  accountId           String
  account             SubcontractAccount     @relation(fields: [accountId], references: [id])
  sequence            Int
  kind                String                 @default("CURRENT")
  stage               String                 @default("DRAFT")
  revision            Int                    @default(1)
  statementDate       DateTime
  notes               String?
  grossCents          Float
  deductionCents      Float
  netCents            Float
  previousGrossCents  Float
  executiveApprovedAt DateTime?
  items               SubcontractItem[]
  deductions          SubcontractDeduction[]
  payments            SubcontractPayment[]
  approvals           SubcontractApproval[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  withdrawals         WorkWithdrawal[]

  @@unique([accountId, sequence])
}

model SubcontractItem {
  id                 String               @id @default(cuid())
  statementId        String
  statement          SubcontractStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  itemKey            String
  position           Int
  name               String
  unit               String
  previousQuantity   Float
  currentQuantity    Float
  entitlementPercent Float
  unitPriceCents     Float
  previousValueCents Float
  totalCents         Float
  sourceItemKey      String?
  priceChangeReason  String?

  @@unique([statementId, itemKey])
}

model SubcontractDeduction {
  id          String               @id @default(cuid())
  statementId String
  statement   SubcontractStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  name        String
  kind        String
  value       Float
  amountCents Float
  position    Int
}

model SubcontractPayment {
  id          String               @id @default(cuid())
  statementId String
  statement   SubcontractStatement @relation(fields: [statementId], references: [id])
  amountCents Float
  paymentDate DateTime
  method      String
  reference   String
  notes       String?
  actorId     String
  createdAt   DateTime             @default(now())
}

model SubcontractApproval {
  id          String               @id @default(cuid())
  statementId String
  statement   SubcontractStatement @relation(fields: [statementId], references: [id])
  fromStage   String
  toStage     String
  reason      String?
  actorId     String
  actorName   String
  revision    Int
  createdAt   DateTime             @default(now())
}

model WorkWithdrawal {
  id                   String               @id @default(cuid())
  sourceAccountId      String
  sourceAccount        SubcontractAccount   @relation("WithdrawalSource", fields: [sourceAccountId], references: [id])
  sourceStatementId    String
  sourceStatement      SubcontractStatement @relation(fields: [sourceStatementId], references: [id])
  destinationAccountId String?              @unique
  destinationAccount   SubcontractAccount?  @relation("WithdrawalDestination", fields: [destinationAccountId], references: [id])
  destinationCompanyId String?
  itemKey              String
  itemName             String
  unit                 String
  itemKeysJson         String
  kind                 String
  quantity             Float?
  withdrawnScope       String
  retainedScope        String?
  retainedItemKey      String?
  reason               String
  effectiveDate        DateTime
  stage                String               @default("DRAFT")
  revision             Int                  @default(1)
  snapshotJson         String
  actorId              String
  createdAt            DateTime             @default(now())

  @@index([sourceAccountId, stage])
}

model ExpenseAttachment {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  name       String
  mime       String
  size       Int
  data       Bytes
  actorId    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
